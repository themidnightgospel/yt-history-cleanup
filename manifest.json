{
  "manifest_version": 3,
  "name": "YouTube Productivity Kit",
  "version": "0.7.0",
  "description": "One-click history delete, home-feed Not interested buttons, grayscale thumbnails, speed and volume controls, and watch check-ins.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    },
    "default_title": "YouTube Productivity Kit"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": ["https://www.youtube.com/*"]
}
